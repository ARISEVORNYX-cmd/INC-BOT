{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; worker-src 'self'; object-src 'none'" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "routes": [
    { "src": "/_lib/(.*)", "status": 404 },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest" },
    { "src": "/service-worker.js", "dest": "/service-worker.js" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/deploy.css", "dest": "/deploy.css" },
    { "src": "/icons/(.*)", "dest": "/icons/$1" },
    { "src": "/deploy/?", "dest": "/deploy.html" },
    { "src": "/deploy.html", "dest": "/deploy.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

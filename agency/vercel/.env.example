# Server-only settings for the Vercel functions. Never commit real values.
# Supabase project URL and anon/publishable key; do NOT use a service_role/secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
ARI_ALLOWED_EMAIL=you@example.com
# Exact canonical website origin, with no trailing path or slash.
# Required in production; use the exact deployment origin (e.g. https://ari.example.com).
ARI_ALLOWED_ORIGIN=https://ari.example.com

# Safe local-first default. The website falls back locally if no model provider is configured.
AI_PROVIDER=local
# To enable an OpenRouter free model later, store the key only as a Vercel encrypted env var.
# AI_PROVIDER=openrouter
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_API_KEY=

# Optional Twilio WhatsApp Sandbox connection check (server-side, Preview only).
# Create a Restricted API Key with only Messaging > Messages > Read permission
# (/twilio/messaging/messages/read). Never use a Twilio Auth Token or broad key.
# Ari only performs a GET for at most one Sandbox message; it has no send action.
# Do not set these in Production without separate approval.
# TWILIO_ACCOUNT_SID=AC<32-hex-characters>
# TWILIO_API_KEY_SID=SK<32-hex-characters>
# TWILIO_API_KEY_SECRET=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
